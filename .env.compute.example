# Compute EC2
CONTROL_PLANE_URL=https://app.driftverk.com
COMPUTE_AGENT_TOKEN=replace-with-the-control-plane-token
COMPUTE_NODE_ID=compute-eu-north-1a-01
COMPUTE_AGENT_VERSION=0.1.0
DATA_GATEWAY_URL=wss://app.driftverk.com/api/tunnel/agent
DOCKER_RUNTIME=sysbox-runc
SANDBOX_NETWORK=bridge
DRIFTVERK_EDGE_NETWORK=driftverk-edge
POLL_INTERVAL_MS=2000
TELEMETRY_INTERVAL_MS=15000
IMAGE_CLEANUP_INTERVAL_MS=900000
IMAGE_CLEANUP_MIN_AGE_HOURS=168
SNAPSHOT_TEMP_RETENTION_HOURS=1
IMAGE_CLEANUP_MAX_IMAGES=50
PREVIEW_GATEWAY_PORT=8081
PREVIEW_DOMAIN=preview.app.driftverk.com
WEB_TERMINAL_PORT=2223
PANEL_HOSTNAME=app.driftverk.com

# Snapshot storage. Keep local only for development; use s3 for a hybrid installation.
SNAPSHOT_STORAGE_DRIVER=local
SNAPSHOT_S3_BUCKET=
SNAPSHOT_S3_REGION=eu-north-1
SNAPSHOT_S3_PREFIX=driftverk/snapshots
SNAPSHOT_S3_ENDPOINT=
SNAPSHOT_S3_FORCE_PATH_STYLE=false
SNAPSHOT_TEMP_DIR_HOST=/var/lib/driftverk/snapshot-tmp

# Persistent S3-backed directories mounted into environments.
VOLUME_STORAGE_DRIVER=local
VOLUME_S3_BUCKET=
VOLUME_S3_REGION=eu-north-1
VOLUME_S3_PREFIX=driftverk/volumes
VOLUME_S3_ENDPOINT=
VOLUME_S3_FORCE_PATH_STYLE=false
VOLUME_MOUNT_ROOT_HOST=/var/lib/driftverk/volumes
VOLUME_CACHE_ROOT_HOST=/var/lib/driftverk/volume-cache

# Prefer an instance role on AWS. Set these only for S3-compatible providers
# or hosts where workload identity is unavailable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
