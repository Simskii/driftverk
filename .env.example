# Self-hosted control plane
INSTALLATION_MODE=self-hosted
OPERATOR_TERMS_URL=
OPERATOR_TERMS_VERSION=
OPERATOR_PRIVACY_URL=
NODE_ENV=development
POSTGRES_DB=driftverk
POSTGRES_USER=driftverk
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Used only by the self-contained compose.yaml PostgreSQL service.
# compose.local.yaml connects to the host PostgreSQL on port 5432 instead.
POSTGRES_PORT=5433
APP_PORT=3000

# Public hostname when this Compose stack is routed through Dokploy's Traefik.
PUBLIC_HOSTNAME=localhost

# Set your HTTPS panel URL in production. It must match APP_DOMAIN.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# First key is active. Keep old keys after it until `docker compose exec control-plane npm run secrets:rotate` succeeds.
# Generate each value with: openssl rand -base64 32
SECRET_ENCRYPTION_KEYS=2026-09=replace-with-a-base64-encoded-32-byte-key
PREVIEW_TOKEN_SECRET=replace-with-at-least-32-random-characters
TERMINAL_TOKEN_SECRET=replace-with-at-least-32-random-characters
SSH_TOKEN_SECRET=replace-with-a-different-32-character-secret
# Private SSH frontend -> data gateway bridge; use a separate random value.
SSH_BRIDGE_SECRET=replace-with-another-32-character-secret
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080
AUTH_ALLOW_SIGN_UP=true
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Keep false until the production Sysbox and network boundary has passed host-level verification.
ALLOW_UNTRUSTED_CODE=false
# Local development prints links to the container log. Production uses resend.
EMAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM=
# Optional signup notification recipient. Blank disables notifications.
SIGNUP_NOTIFICATION_EMAIL=

# Shared only with trusted compute agents.
COMPUTE_AGENT_TOKEN=replace-with-at-least-32-random-characters
MANAGED_COMPUTE_NODE_ID=compute-1
DEFAULT_SANDBOX_IMAGE=driftverk-dev:1
SSH_PUBLIC_HOST=localhost
SSH_PUBLIC_PORT=2222
PREVIEW_DOMAIN=preview.localhost
# GitHub App with Contents: read and callback URL ${BETTER_AUTH_URL}/api/github/callback,
# and "Request user authorization during installation" enabled.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
DATA_GATEWAY_PORT=3001
MAX_STREAMS_PER_AGENT=512

# Caddy. Set a real hostname in production for automatic HTTPS.
APP_DOMAIN=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# Stripe Checkout and Customer Portal. Configure automatic tax and the webhook before enabling payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
